exports[`Markdown renders templates ignores unrecognised templates 1`] = `
<div
  class="content"
  data-testid="markdown-content"
>
  <p>
    <markdown-template
      args="[]"
      name="no-template"
    />
  </p>
</div>
`;

exports[`Markdown renders templates renders message for empty templates 1`] = `
