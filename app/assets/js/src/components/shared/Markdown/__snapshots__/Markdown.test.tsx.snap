// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`Markdown renders templates ignores unrecognised templates 1`] = `
<div
  class="content"
  data-testid="markdown-content"
>
  <p>
    <markdown-template
      alias="no-template"
      args="[]"
    />
  </p>
</div>
`;

exports[`Markdown renders templates renders message for empty templates 1`] = `
<div
  class="content"
  data-testid="markdown-content"
>
  <p>
    <markdown-template
      alias="empty"
      args="[]"
    />
  </p>
</div>
`;

exports[`Markdown renders templates renders two templates with arguments on the same line 1`] = `
<div
  class="content"
  data-testid="markdown-content"
>
  <p>
    <markdown-template
      alias="args"
      args="["arg0","arg1"]"
    />
     
    <markdown-template
      alias="args"
      args="["arg0","arg1"]"
    />
  </p>
</div>
`;

exports[`Markdown renders templates with a recognised name 1`] = `
