exports[`Markdown renders task links 1`] = `
<div
  class="content"
  data-testid="markdown-content"
>
  <p>
    Here's a task link: 
    <task-link
      taskid="1"
    >
      <span
        class="task-link task-link--initial"
      />
    </task-link>
     
    <em>
      what do you think?
    </em>
  </p>
  

</div>
`;

