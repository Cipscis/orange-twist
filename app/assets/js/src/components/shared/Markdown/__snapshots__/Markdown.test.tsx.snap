exports[`Markdown renders templates renders two templates with arguments on the same line 1`] = `
<div
  class="content"
  data-testid="markdown-content"
>
  <p>
    <markdown-template
      args="["arg0","arg1"]"
      name="args"
    />
     
    <markdown-template
      args="["arg0","arg1"]"
      name="args"
    />
  </p>
</div>
`;

