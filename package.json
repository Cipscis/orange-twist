{
	"name": "orange-twist",
	"version": "2.0.0",
	"description": "A task management tool designed for my personal style of working.",
	"private": true,
	"type": "module",
	"scripts": {
		"server": "node --env-file-if-exists=.env scripts/server.ts",

		"build:js": "node --env-file-if-exists=.env scripts/build.ts",
		"build:css": "sass app/assets/scss:app/assets/css --style=compressed",
		"build": "concurrently --group \"npm:build:*\"",

		"test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config=./test/jest.config.ts",
		"test:unit:coverage": "npm run test:unit -- --collectCoverage",
		"test:types": "tsc",
		"test": "concurrently --group \"npm:test:*(!unit:coverage)\"",

		"watch-build:js": "node --env-file-if-exists=.env scripts/build-watch.ts",
		"watch-build:css": "npm run build:css -- --watch",
		"watch-test:unit": "npm run test:unit -- --watch",
		"watch-test:types": "npm run test:types -- --watch --preserveWatchOutput",
		"watch:build": "concurrently --kill-others --prefix-colors blue,magenta \"npm:watch-build:*\"",
		"watch:test": "concurrently --kill-others --prefix-colors green,blue \"npm:watch-test:*\"",
		"watch": "concurrently --kill-others --prefix-colors blue,green \"npm:watch:*\"",

		"lint:js": "eslint app/assets/js/src/**",
		"lint:css": "stylelint app/assets/scss/**/*.scss",
		"lint": "concurrently --group --prefix-colors blue,magenta \"npm:lint:*\"",

		"start": "concurrently --kill-others --names server,build,test --prefix-colors yellow,magenta,green \"npm:server\" \"npm:watch:build\"",
		"start:test": "npm run start -- \"npm:watch:test\""
	},
	"author": "Brooke Hart",
	"repository": {
		"type": "git",
		"url": "https://github.com/cipscis/orange-twist.git"
	},
	"license": "Hippocratic-2.1",
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^9.39.4",
		"@jest/globals": "^30.5.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/preact": "^3.2.6",
		"@testing-library/user-event": "^14.6.8",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/web": "^0.0.359",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"concurrently": "^10.0.6",
		"cross-env": "^10.1.0",
		"esbuild": "~0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-import-newlines": "^1.4.1",
		"eslint-plugin-jest": "^29.17.0",
		"eslint-plugin-jsdoc": "^65.4.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"express": "^5.3.0",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jsdom-testing-mocks": "^1.16.0",
		"sass": "^1.107.0",
		"stylelint": "^17.16.0",
		"stylelint-config-recommended-scss": "^17.0.1",
		"ts-jest": "^29.4.15",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=26.5.0"
	},
	"dependencies": {
		"highlight.js": "^11.12.0",
		"marked": "^18.1.2",
		"marked-highlight": "^2.2.4",
		"preact": "^10.29.8",
		"zod": "^4.6.7"
	}
}
