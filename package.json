{
	"name": "orange-twist",
	"version": "2.0.0",
	"description": "A task management tool designed for my personal style of working.",
	"private": true,
	"type": "module",
	"scripts": {
		"server": "node --env-file-if-exists=.env scripts/server.ts",

		"build:js": "concurrently \"tsc\" \"node --env-file-if-exists=.env scripts/build.ts\"",
		"build:css": "sass app/assets/scss:app/assets/css --style=compressed",
		"build": "concurrently \"npm:build:*\"",

		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config=./test/jest.config.ts",
		"test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config=./test/jest.config.ts --collectCoverage",

		"watch:js": "node --env-file-if-exists=.env scripts/build-watch.ts",
		"watch:css": "sass app/assets/scss:app/assets/css --watch --style=compressed",
		"watch:test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config=./test/jest.config.ts --watch",
		"watch": "concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"npm:watch:*\"",

		"lint:js": "eslint app/assets/js/src/**",
		"lint:css": "stylelint app/assets/scss/**/*.scss",
		"lint": "concurrently \"npm:lint:*\"",

		"start": "concurrently --kill-others \"npm run server\" \"npm run watch\""
	},
	"author": "Brooke Hart",
	"repository": {
		"type": "git",
		"url": "https://github.com/cipscis/orange-twist.git"
	},
	"license": "Hippocratic-2.1",
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^9.39.4",
		"@jest/globals": "^30.4.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/preact": "^3.2.4",
		"@testing-library/user-event": "^14.6.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"@typescript-eslint/parser": "^8.63.0",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"esbuild": "~0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-import-newlines": "^1.4.0",
		"eslint-plugin-jest": "^29.15.4",
		"eslint-plugin-jsdoc": "^63.0.12",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"express": "^5.2.1",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.7.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jsdom-testing-mocks": "^1.16.0",
		"sass": "^1.101.0",
		"stylelint": "^17.14.0",
		"stylelint-config-recommended-scss": "^17.0.1",
		"ts-jest": "^29.4.11",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=26.5.0"
	},
	"dependencies": {
		"highlight.js": "^11.11.1",
		"marked": "^17.0.6",
		"marked-highlight": "^2.2.4",
		"preact": "^10.29.7",
		"preact-render-to-string": "^6.7.0",
		"zod": "^4.4.3"
	}
}
